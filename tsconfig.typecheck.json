{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "noEmit": true,
        "paths": {
            "infini-core": ["./packages/infini-core/src/index.ts"],
            "infini-dom-support": [
                "./packages/infini-dom-support/src/index.ts"
            ],
            "infini-react": ["./packages/infini-react/src/index.ts"]
        }
    },
    "include": [
        "playwright.config.ts",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "packages/*/test/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "tests/**/*.mts"
    ]
}
