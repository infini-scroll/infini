{
    "name": "@infini-scroll/core",
    "version": "0.1.3",
    "description": "Engine for Infini",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/infini-scroll/infini.git",
        "directory": "packages/infini-core"
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "shx rm -rf dist && tsgo -p tsconfig.build.json && shx cp -r ./src/runtime/wasm ./dist/runtime/",
        "typecheck": "tsgo -p tsconfig.json"
    }
}
